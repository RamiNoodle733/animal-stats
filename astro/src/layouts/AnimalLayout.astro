---
import SiteLayout from './SiteLayout.astro';

const { title, description, canonical, image, jsonLd } = Astro.props;
---

<SiteLayout
    title={title}
    description={description}
    canonical={canonical}
    image={image}
    jsonLd={jsonLd}
    activeNav="stats"
    styles={['/css/pages/animal-static.css']}
    skipLabel="Skip to animal stats"
    footerLabel="Static animal profile"
>
    <slot />
</SiteLayout>
