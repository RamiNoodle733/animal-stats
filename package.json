{
  "name": "animal-battle-stats",
  "version": "2.7.0",
  "description": "Animal Battle Stats - a versioned wildlife comparison and animal powerscaling website",
  "main": "api/index.js",
  "scripts": {
    "dev": "echo 'Use: vercel dev'",
    "start": "echo 'Use: vercel dev'",
    "build": "node scripts/build-production.js",
    "seed": "node scripts/seed-database.js",
    "hooks:install": "git config core.hooksPath .githooks",
    "security:exports": "node scripts/security/check-sensitive-exports.js",
    "test": "node --test test/**/*.test.js",
    "recovery:geolocations": "node scripts/migrations/repair-activity-geolocations.js",
    "recovery:import-activity": "node scripts/migrations/import-site-activity.js",
    "version:sync": "node scripts/version/bump-site-version.js --sync-only",
    "version:check": "node scripts/version/check-site-version.js",
    "version:bump:patch": "node scripts/version/bump-site-version.js --bump patch",
    "version:bump:minor": "node scripts/version/bump-site-version.js --bump minor",
    "version:bump:major": "node scripts/version/bump-site-version.js --bump major",
    "lint": "eslint js/ api/ lib/",
    "lint:fix": "eslint js/ api/ lib/ --fix",
    "perf:budget": "node scripts/performance/check-route-budgets.js",
    "preview:readonly": "node scripts/verification/serve-readonly-preview.js",
    "verify:responsive-images": "node scripts/verification/verify-responsive-images-browser.js",
    "verify:ui-stability": "node scripts/verification/verify-ui-stability-browser.js",
    "verify:community": "node scripts/verification/verify-community-browser.js",
    "seo:prerender": "node scripts/prerender-seo-pages.mjs",
    "astro:build": "astro build",
    "seo:sitemap": "node scripts/generate-sitemap.mjs",
    "seo:audit": "node scripts/seo-audit.mjs",
    "assets:pipeline": "node scripts/assets/animal-image-pipeline.js",
    "assets:audit": "node scripts/assets/animal-image-pipeline.js audit",
    "assets:dimensions": "node scripts/assets/generate-animal-image-dimensions.js",
    "assets:promote": "node scripts/assets/animal-image-pipeline.js promote",
    "assets:sync-images": "node scripts/assets/animal-image-pipeline.js sync",
    "assets:source": "node scripts/assets/animal-image-pipeline.js source",
    "assets:generate-silhouettes": "node scripts/assets/generate-silhouettes.js"
  },
  "keywords": [
    "animals",
    "wildlife",
    "statistics",
    "vercel",
    "mongodb"
  ],
  "author": "RamiNoodle733",
  "license": "MIT",
  "dependencies": {
    "@vercel/functions": "3.9.3",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "7.5.0",
    "mongoose": "9.9.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "astro": "7.2.6",
    "dotenv": "^16.3.1",
    "eslint": "^9.39.4",
    "globals": "^17.0.0",
    "playwright": "^1.57.0",
    "sharp": "^0.34.5",
    "vercel": "^33.0.0"
  },
  "engines": {
    "node": "24.x"
  }
}
